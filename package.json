{
  "name": "qts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#config/*": "./src/config/*",
    "#domain/*": "./src/domain/*",
    "#ta/*": "./src/ta/*",
    "#regime/*": "./src/regime/*",
    "#execution/*": "./src/execution/*",
    "#broker/*": "./src/broker/*",
    "#state/*": "./src/state/*",
    "#backtest/*": "./src/backtest/*",
    "#observability/*": "./src/observability/*",
    "#server/*": "./src/server/*"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:mock": "node scripts/run-mock.js",
    "seed": "node scripts/seed-demo-data.js",
    "check:db": "node scripts/check-db-connection.js",
    "test": "vitest run",
    "lint": "eslint .",
    "backtest": "node scripts/run-backtest.js",
    "postinstall": "node scripts/seed-demo-data.js"
  },
  "dependencies": {
    "dotenv": "latest",
    "kiteconnect": "latest",
    "next": "latest",
    "p-retry": "latest",
    "pg": "latest",
    "pino": "latest",
    "react": "latest",
    "react-dom": "latest",
    "ws": "^8.21.3",
    "yaml": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "latest",
    "globals": "^17.12.0",
    "vitest": "latest"
  }
}
